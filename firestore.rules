rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAdmin() {
      return request.auth != null 
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function isSuperAdmin() {
      return request.auth != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'superadmin';
    }

    function isAdminOrSuperAdmin() {
      return isAdmin() || isSuperAdmin();
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users: Public Read, Owner/Admin Write
    match /users/{userId} {
      allow get: if true;
      allow list: if request.auth != null;

      // Create: Owner can create their own doc; Admin/SuperAdmin can create any user doc (needed for setDoc merge on non-existent docs)
      allow create: if isOwner(userId) || isAdminOrSuperAdmin();

      // Update:
      // 1. A user can update their own document
      // 2. A SuperAdmin can update ANY user document (including other superadmins)
      // 3. A regular Admin can update non-superadmin user documents only
      allow update: if (
        isOwner(userId)
        || isSuperAdmin()
        || (isAdmin() && resource.data.get('role', '') != 'superadmin')
      );

      // Delete:
      // SuperAdmin can delete anyone; Admin can only delete non-superadmins
      allow delete: if (
        isSuperAdmin()
        || (isAdmin() && resource.data.get('role', '') != 'superadmin')
      );
    }

    // Boards: Public Read
    match /boards/{boardId} {
      allow read: if true;
      
      // Create: Strict validation
      allow create: if request.auth != null 
                    && request.resource.data.sellerId == request.auth.uid
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.lifecycleStatus == 'active'
                    && request.resource.data.status == 'Live'
                    && request.resource.data.isPaid == false;

      // Update: Admin OR Strict Owner validation
      allow update: if request.auth != null && (
        isAdminOrSuperAdmin() || 
        (
            resource.data.sellerId == request.auth.uid
            && request.resource.data.sellerId == resource.data.sellerId
            && request.resource.data.get('condition', '') == resource.data.get('condition', '')
            && request.resource.data.get('isPaid', false) == resource.data.get('isPaid', false)
            && request.resource.data.get('ownerId', request.auth.uid) == resource.data.get('ownerId', request.auth.uid)
            && request.resource.data.get('listingType', '') == resource.data.get('listingType', '')
            && (
                // Scenario A: Normal Edit (Status Unchanged)
                (
                   request.resource.data.status == resource.data.status
                )
                ||
                // Scenario B: Renewal / Reactivation
                (
                   request.resource.data.status == 'Live'
                   && resource.data.status != 'Live'
                   && request.resource.data.lifecycleStatus == 'active'
                )
                ||
                // Scenario C: Deactivation / Sold
                (
                   (request.resource.data.status == 'Sold' || request.resource.data.status == 'Expired')
                   && resource.data.status == 'Live'
                   && request.resource.data.get('lifecycleStatus', '') == 'inactive'
                )
            )
        )
      );
                    
      allow delete: if request.auth != null && (resource.data.sellerId == request.auth.uid || isAdminOrSuperAdmin());
    }

    // App Configuration & Admin Collections
    match /appSettings/{document=**} {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin();
    }

    match /branding/{document=**} {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin();
    }

    match /donationEntries/{document=**} {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin();
    }

    match /ads/{adId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    match /giveawayImages/{document=**} {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin();
    }

    // Discount Codes: Public read for validation, Admin write
    match /discountCodes/{codeId} {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin();
    }

    // FCM Tokens: Authenticated users can manage their own tokens
    match /fcmTokens/{tokenId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null 
                            && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null;
    }

    // Carts: User can read/write their own cart
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}